# 百度地图开放平台的服务端 AK，需开通 Web 服务 API。
# 需要在百度地图开放平台为对应应用启用 Web 服务 API（地理编码、地点检索）。
BAIDU_MAP_AK=
# 如果此 AK 在控制台选用 SN 签名校验，请填入对应的 Security Key。
BAIDU_MAP_SK=

# 小野模型：本地免费 Qwen3 小模型，需要安装 Ollama 并执行 ollama pull qwen3:1.7b。
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b

# 也可使用托管 API：删除 LLM_PROVIDER=ollama 并填写下列配置。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=responses
